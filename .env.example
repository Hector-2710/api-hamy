# Application
APP_ENV=development
HTTP_PORT=8080
LOG_LEVEL=info
# Comma-separated origins allowed to call the API from a browser. "*" = any.
CORS_ALLOWED_ORIGINS=*

# Authentication (JWT, HS256).
# JWT_SECRET must be at least 32 characters. It is required when
# APP_ENV=production; in development it falls back to an insecure default.
JWT_SECRET=dev-only-insecure-secret-change-me-please
JWT_ISSUER=api-hamy
JWT_TTL=24h

# Demo credentials used by `make seed`. Passwords must be at least 8 characters.
SEED_USER_PASSWORD=demo-password
SEED_ADMIN_PASSWORD=admin-password

# Database
DB_DSN=postgres://hamy:hamy@localhost:5432/hamy?sslmode=disable
DB_MAX_CONNS=10
# Used by `make test-integration` (defaults to DB_DSN if empty).
DB_TEST_DSN=

# Postgres (docker compose)
POSTGRES_USER=hamy
POSTGRES_PASSWORD=hamy
POSTGRES_DB=hamy

# MinIO (docker compose)
MINIO_ENDPOINT=localhost:9000
# Endpoint that appears in presigned URLs. In Docker the API signs with
# localhost:9000 even though it uses minio:9000 internally.
MINIO_PUBLIC_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=hamyadmin
MINIO_SECRET_KEY=hamyadmin123
MINIO_BUCKET=hamy-photos
MINIO_REGION=us-east-1
MINIO_USE_SSL=false
# TLS for presigned URLs (defaults to MINIO_USE_SSL).
MINIO_PUBLIC_USE_SSL=false
# CORS for the S3 API: required for browser uploads to the presigned PUT URL.
MINIO_API_CORS_ALLOW_ORIGIN=*
# Pinned MinIO image (tag + digest) for reproducible deployments.
# MinIO stopped publishing on minio/minio; bitnamilegacy keeps a working build.
# MINIO_IMAGE=bitnamilegacy/minio:2025.7.23-debian-12-r5@sha256:6dabb4a2088c9a79908de3bc05f4586c23ad2182c8908e7e3acbf61c1467fb20
# TTL for presigned upload and download URLs
UPLOAD_URL_TTL=15m
